NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_NAME="Bangron Virtual Office"
APP_URL="http://localhost:3000"

# Security & Session (generate a unique secret: openssl rand -hex 48)
SESSION_SECRET=
SESSION_MAX_AGE_MS=86400000

# Database
DATABASE_PATH=storage/database/bangron-virtual-office.sqlite
DATABASE_BUSY_TIMEOUT=5000

# Hermes Integration (webhook secret: openssl rand -hex 32)
HERMES_API_URL=http://localhost:8000
HERMES_API_KEY=
HERMES_WEBHOOK_SECRET=
HERMES_RUNTIME_VERIFIED=false

# Director Initial Account (set a unique password of at least 12 characters before first seed)
INITIAL_DIRECTOR_EMAIL=director@bangron.office
INITIAL_DIRECTOR_PASSWORD=
INITIAL_DIRECTOR_NAME=Bangron

# Logging
LOG_LEVEL=info

# Demo auto-play director (agents walk according to their active tasks)
DEMO_AUTOPLAY=true
