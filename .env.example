NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_NAME="Bangron Virtual Office"
APP_URL="http://localhost:3000"

# Security & Session
SESSION_SECRET=bangron-virtual-office-super-secret-key-change-in-prod-2026
SESSION_MAX_AGE_MS=86400000

# Database
DATABASE_PATH=storage/database/bangron-virtual-office.sqlite
DATABASE_BUSY_TIMEOUT=5000

# Hermes Integration
HERMES_API_URL=http://localhost:8000
HERMES_API_KEY=
HERMES_WEBHOOK_SECRET=bangron-hermes-webhook-secret-key-2026
HERMES_RUNTIME_VERIFIED=false

# Director Initial Account
INITIAL_DIRECTOR_EMAIL=director@bangron.office
INITIAL_DIRECTOR_PASSWORD=DirectorPass123!
INITIAL_DIRECTOR_NAME=Bangron

# Logging
LOG_LEVEL=info

# Demo auto-play director (agents walk according to their active tasks)
DEMO_AUTOPLAY=true
